<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera: needed to see faces. Asked at runtime, with a reason shown first. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Background camera is only allowed through a foreground service of type "camera". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Needed (Android 13+) to show the status notification and the privacy alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Only used to show a "Tap to restart" notification after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app ask you (one tap dialog) to turn off battery optimization. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- There is no INTERNET permission, and it is actively REMOVED below in case a library
         (for example ML Kit) tries to add it. Without it, Android blocks all network access for this app,
         so face data cannot leave the phone even by mistake. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivacyGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The service that watches the front camera. Type "camera" is required on Android 14/15. -->
        <service
            android:name=".service.PrivacyGuardService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- After a restart Android does not let us start the camera service by ourselves.
             This receiver only shows a notification: "Tap to restart Privacy Guard". -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
